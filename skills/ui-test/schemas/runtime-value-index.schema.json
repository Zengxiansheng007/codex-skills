{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/runtime-value-index.v1.json",
  "title": "UI-Test Runtime Value Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "runtime_values", "exploration_values", "manual_hash"],
  "properties": {
    "schema_version": {"const": "ui-test.runtime-value-index.v1"},
    "environment": {"enum": ["public", "test", "staging", "production"]},
    "runtime_values": {"type": "object", "additionalProperties": {"$ref": "#/$defs/runtimeValueEntry"}},
    "exploration_values": {"type": "object", "additionalProperties": {"$ref": "#/$defs/explorationValueEntry"}},
    "runtime_state": {"type": "object", "additionalProperties": {"$ref": "#/$defs/runtimeStateEntry"}, "description": "Machine-maintained mutable sequence state, never part of the manual hash."},
    "required_runtime_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "manual_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "runtimeStateEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_value", "allocations", "scope", "description"],
      "properties": {
        "next_value": {"type": "integer", "minimum": 1, "description": "The value the next allocation will hand out."},
        "scope": {"type": "string", "minLength": 1, "description": "Declared allocation scope, e.g. project/product/branch."},
        "description": {"type": "string", "description": "Human-readable allocation purpose."},
        "allocations": {
          "type": "array",
          "description": "Append-only allocation ledger used for duplicate-run rejection and audit.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "run_id", "allocated_at", "evidence_ref"],
            "properties": {
              "value": {"type": "integer", "minimum": 1},
              "run_id": {"type": "string", "minLength": 1},
              "allocated_at": {"type": "string", "minLength": 1},
              "evidence_ref": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "runtimeValueEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source_type", "description"],
      "properties": {
        "value": {"type": ["string", "number", "boolean", "integer"]},
        "source_type": {"enum": ["literal", "reference"]},
        "description": {"type": "string", "minLength": 1},
        "index_ref": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    },
    "explorationValueEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source_type", "status", "run_id", "discovered_at", "scope", "evidence_ref"],
      "properties": {
        "value": {"type": ["string", "number", "boolean", "integer"]},
        "source_type": {"enum": ["literal", "reference"]},
        "status": {"enum": ["candidate", "active", "superseded"]},
        "run_id": {"type": "string", "minLength": 1},
        "discovered_at": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "index_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
