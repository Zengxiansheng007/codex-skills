{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/test-data.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "branch_id", "data_revision", "parameters", "generation_rules", "runtime_refs", "metadata"],
  "properties": {
    "schema_version": {"const": "ui-test.test-data.v2"},
    "case_id": {"type": "string", "minLength": 1},
    "branch_id": {"type": "string", "minLength": 1},
    "data_revision": {"type": "integer", "minimum": 1},
    "parameters": {"type": "object", "minProperties": 1},
    "generation_rules": {"type": "object"},
    "expected_defaults": {"type": "object"},
    "runtime_refs": {"type": "array", "items": {"type": "string", "pattern": "^(value|credential|sequence):.+$"}, "uniqueItems": true},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "manually_editable"],
      "properties": {"owner": {"type": "string", "minLength": 1}, "manually_editable": {"const": true}, "description": {"type": "string"}}
    },
    "notes": {"type": "string"}
  }
}
