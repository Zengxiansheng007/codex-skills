{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/r2-approval-record.schema.v2.json",
  "title": "R2 Approval Record V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "approval_source",
    "run_id",
    "node_id",
    "case_id",
    "branch_id",
    "environment",
    "allowed_action",
    "channel",
    "max_submit_count",
    "decision",
    "boundary_hash",
    "credential_values_persisted",
    "reusable_across_runs",
    "risk_level",
    "stable_runner_digest",
    "active_build_fingerprint",
    "active_attachment_digest"
  ],
  "properties": {
    "schema_version": {"const": "ui-test.r2-approval-record.v2"},
    "approval_id": {"type": "string", "minLength": 1},
    "approval_source": {"enum": ["explicit-cli", "pycharm-project-policy", "not-approved"]},
    "run_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "branch_id": {"type": "string", "minLength": 1},
    "environment": {"const": "test"},
    "allowed_action": {"type": "string", "minLength": 1},
    "channel": {"const": "visible-ui"},
    "max_submit_count": {"const": 1},
    "decision": {"enum": ["approved", "denied"]},
    "boundary_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "credential_values_persisted": {"const": false},
    "reusable_across_runs": {"const": false},
    "risk_level": {"enum": ["r0-read-only", "r1-read-only-authenticated", "r2-ui-write-test"]},
    "stable_runner_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "active_build_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "active_attachment_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
