{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/ui-test-packet.schema.v1.json",
  "title": "Unified UI-Test Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "packet_type", "scope", "risk_level", "state", "case", "branch", "run", "steps", "lineage", "evidence_policy", "retry_policy", "next_action"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "packet_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "packet_type": {"const": "ui-test-packet"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["project_group", "product", "system", "module", "function", "checkpoint", "environment", "risk_level"],
      "properties": {
        "project_group": {"type": "string", "minLength": 1}, "product": {"type": "string", "minLength": 1},
        "system": {"type": "string", "minLength": 1}, "module": {"type": "string", "minLength": 1},
        "function": {"type": "string", "minLength": 1}, "checkpoint": {"type": "string", "minLength": 1},
        "environment": {"enum": ["public", "test", "staging", "production"]},
        "risk_level": {"enum": ["r0-read-only", "r1-read-only-authenticated", "r2-ui-write-test", "r3-high-impact"]}
      }
    },
    "risk_level": {"enum": ["r0-read-only", "r1-read-only-authenticated", "r2-ui-write-test", "r3-high-impact"]},
    "effective_risk_level": {"enum": ["r0-read-only", "r1-read-only-authenticated", "r2-ui-write-test", "r3-high-impact"]},
    "execution_policy_ref": {"type": "string", "minLength": 1},
    "state": {"enum": ["requirements-review", "plan", "preflight", "explore", "verify", "evidence", "review", "checkpoint", "learn", "report", "repair", "rerun", "blocked", "done"]},
    "case": {"type": "object", "additionalProperties": false, "required": ["case_id"], "properties": {"case_id": {"type": "string", "minLength": 1}, "title": {"type": "string"}}},
    "branch": {"type": "object", "additionalProperties": false, "required": ["branch_id"], "properties": {"branch_id": {"type": "string", "minLength": 1}, "parent_case_id": {"type": "string"}}},
    "run": {"type": "object", "additionalProperties": false, "required": ["run_id", "started_at"], "properties": {"run_id": {"type": "string", "minLength": 1}, "started_at": {"type": "string", "minLength": 1}}},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "lineage": {"type": "object", "additionalProperties": false, "required": ["anchor_id", "source_refs"], "properties": {"anchor_id": {"type": "string", "minLength": 1}, "source_refs": {"type": "array", "items": {"type": "string"}}}},
    "evidence_policy": {"type": "object", "additionalProperties": false, "required": ["screenshot_on_ui_change", "redaction_required"], "properties": {"screenshot_on_ui_change": {"const": true}, "redaction_required": {"const": true}}},
    "retry_policy": {"type": "object", "additionalProperties": false, "required": ["max_attempts", "fallback_allowed"], "properties": {"max_attempts": {"type": "integer", "minimum": 0, "maximum": 3}, "fallback_allowed": {"type": "boolean"}}},
    "next_action": {"enum": ["route", "validate", "explore", "verify", "collect-evidence", "review", "promote-candidate", "repair", "rerun", "blocked", "complete"]}
  },
  "$defs": {
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id", "action", "risk_level", "required"],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "action": {"enum": ["login", "navigate", "module-ready", "click", "fill", "select", "check", "query", "assert", "explore", "verify", "screenshot", "observe-network", "submit", "update", "delete", "approve", "publish"]},
        "risk_level": {"enum": ["r0-read-only", "r1-read-only-authenticated", "r2-ui-write-test", "r3-high-impact"]},
        "required": {"type": "boolean"},
        "intent": {"type": "string"},
        "postcondition": {"type": "string"}
      }
    }
  }
}
