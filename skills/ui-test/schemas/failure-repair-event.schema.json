{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/failure-repair-event.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "idempotency_key", "occurred_at", "log_date", "product_id", "case_id", "branch_id", "problem_fingerprint", "category", "summary", "evidence"],
  "properties": {
    "schema_version": {"const": "ui-test.failure-repair-event.v2"},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["failure-detected", "sync-required", "repair-completed", "sync-completed"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "log_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "product_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "branch_id": {"type": "string", "minLength": 1},
    "problem_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "category": {"enum": ["parameter-drift", "compile-sync", "release-integrity", "execution-guard", "test-failure", "migration", "cleanup", "governance"]},
    "summary": {"type": "string", "minLength": 1},
    "source_files": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "ref", "sha256"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
