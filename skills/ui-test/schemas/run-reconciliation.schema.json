{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/run-reconciliation.schema.v1.json",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "canonical_run_result_hash",
    "original_write_state",
    "reconciled_write_state",
    "reason_code",
    "evidence",
    "canonical_run_result_unchanged",
    "reconciliation_effect",
    "rerun_authorization_effect",
    "created_at",
    "reconciliation_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "ui-test.run-reconciliation.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "canonical_run_result_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "original_write_state": {"enum": ["write_outcome_unknown", "submitted_unknown"]},
    "reconciled_write_state": {"enum": ["write_failed", "write_succeeded_verified", "write_succeeded_verification_failed"]},
    "reason_code": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "sha256", "observation"],
        "additionalProperties": false,
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "observation": {"type": "string", "minLength": 1}
        }
      }
    },
    "canonical_run_result_unchanged": {"const": true},
    "reconciliation_effect": {"const": "diagnostic-only"},
    "rerun_authorization_effect": {"const": "none"},
    "created_at": {"type": "string", "format": "date-time"},
    "reconciliation_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
