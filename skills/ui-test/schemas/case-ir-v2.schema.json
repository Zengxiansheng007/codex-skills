{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/case-ir.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "branch_id", "case_version", "source_hash", "test_data_hash", "parameter_manifest_hash", "scope", "priority", "risk_level", "steps", "dependency_refs"],
  "properties": {
    "schema_version": {"const": "ui-test.case-ir.v2"},
    "case_id": {"type": "string"},
    "branch_id": {"type": "string"},
    "case_version": {"type": "integer", "minimum": 1},
    "source_hash": {"$ref": "#/$defs/hash"},
    "test_data_hash": {"$ref": "#/$defs/hash"},
    "parameter_manifest_hash": {"$ref": "#/$defs/hash"},
    "scope": {"type": "object"},
    "priority": {"enum": ["P0", "P1", "P2"]},
    "risk_level": {"enum": ["R0", "R1", "R2"]},
    "steps": {"type": "array", "minItems": 1},
    "dependency_refs": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
