{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/credential-index.v1.json",
  "title": "UI-Test Credential Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "credentials", "manual_hash"],
  "properties": {
    "schema_version": {"const": "ui-test.credential-index.v1"},
    "environment": {"enum": ["public", "test", "staging", "production"]},
    "credentials": {"type": "object", "additionalProperties": {"$ref": "#/$defs/credentialEntry"}},
    "required_credential_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "manual_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "credentialEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "description", "sensitive"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "sensitive": {"const": true},
        "notes": {"type": "string"}
      }
    }
  }
}
