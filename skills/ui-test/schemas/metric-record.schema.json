{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/metric-record.schema.v1.json",
  "type": "object",
  "required": ["schema_version", "metric_name", "value", "unit", "labels", "sample_count", "stability"],
  "properties": {
    "schema_version": {"const": "ui-test.metric-record.v1"},
    "metric_name": {"type": "string", "minLength": 1},
    "value": {"type": "number"},
    "unit": {"type": "string"},
    "labels": {"type": "object"},
    "sample_count": {"type": "integer", "minimum": 0},
    "stability": {"enum": ["insufficient-sample", "sampled"]}
  }
}
