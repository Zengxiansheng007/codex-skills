{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/failure-history-index.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "generated_at", "days", "event_count", "idempotency_keys", "projection_hash"],
  "properties": {
    "schema_version": {"const": "ui-test.failure-history-index.v2"},
    "product_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "days": {"type": "array", "items": {"type": "object"}},
    "event_count": {"type": "integer", "minimum": 0},
    "idempotency_keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "projection_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
