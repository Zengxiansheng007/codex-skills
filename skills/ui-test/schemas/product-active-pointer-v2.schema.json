{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/product-active-pointer.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "status", "product_id", "build_fingerprint", "manifest_ref", "included_cases_hash", "deployment_authorization_ref"],
  "properties": {
    "schema_version": {"const": "ui-test.product-active-pointer.v2"},
    "scope": {"const": "product"},
    "status": {"const": "active"},
    "product_id": {"type": "string"},
    "build_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "manifest_ref": {"type": "string", "pattern": "^releases/[0-9a-f]{64}/manifest\\.json$"},
    "included_cases_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "deployment_authorization_ref": {"type": "string", "minLength": 1}
  }
}
