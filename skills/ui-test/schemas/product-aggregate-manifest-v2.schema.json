{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/product-aggregate-manifest.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "is_unmodified", "project_group_display_name", "product_id", "product_display_name", "system_display_name", "scope", "included_cases", "compiler_version", "renderer_version", "config_fingerprint", "markdown_hash", "outline_hash", "aggregate_hash"],
  "properties": {
    "schema_version": {"const": "ui-test.product-aggregate-manifest.v2"},
    "status": {"const": "in_sync"},
    "is_unmodified": {"const": true},
    "project_group_display_name": {"type": "string", "minLength": 1},
    "product_id": {"type": "string", "minLength": 1},
    "product_display_name": {"type": "string", "minLength": 1},
    "system_display_name": {"type": "string", "minLength": 1},
    "scope": {"type": "object", "additionalProperties": false, "required": ["project_group", "product", "system", "module_path", "function"], "properties": {"project_group": {"type": "string"}, "product": {"type": "string"}, "system": {"type": "string"}, "module_path": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "function": {"type": "string"}}},
    "included_cases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "branch_id", "priority", "source_hash", "test_data_hash", "parameter_manifest_hash", "case_manifest_hash", "build_fingerprint"], "properties": {"case_id": {"type": "string"}, "branch_id": {"type": "string"}, "priority": {"enum": ["P0", "P1", "P2"]}, "source_hash": {"$ref": "#/$defs/hash"}, "test_data_hash": {"$ref": "#/$defs/hash"}, "parameter_manifest_hash": {"$ref": "#/$defs/hash"}, "case_manifest_hash": {"$ref": "#/$defs/hash"}, "build_fingerprint": {"$ref": "#/$defs/hash"}}}},
    "compiler_version": {"type": "string", "minLength": 1},
    "renderer_version": {"type": "string", "minLength": 1},
    "config_fingerprint": {"$ref": "#/$defs/hash"},
    "markdown_hash": {"$ref": "#/$defs/hash"},
    "outline_hash": {"$ref": "#/$defs/hash"},
    "aggregate_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
