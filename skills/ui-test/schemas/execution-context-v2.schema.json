{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/execution-context.schema.v2.json",
  "title": "Execution Context V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_origin",
    "origin_evidence",
    "run_id",
    "node_id",
    "case_id",
    "branch_id",
    "risk_level",
    "environment",
    "approved",
    "approval_source",
    "stable_runner_digest",
    "active_build_fingerprint",
    "active_attachment_digest",
    "project_config_digest",
    "attempt_ref"
  ],
  "properties": {
    "schema_version": {"const": "ui-test.execution-context.v2"},
    "execution_origin": {"enum": ["pycharm", "codex-cli", "cli", "ci", "unknown"]},
    "origin_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "evidence_digest"],
      "properties": {
        "source_type": {"enum": ["jetbrains-runner-path", "sys-argv", "ci-env", "explicit-cli-arg", "unknown"]},
        "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "runner_path_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "argv0": {"type": "string", "minLength": 1, "not": {"pattern": "^(?:[A-Za-z]:|/|\\\\)"}},
        "invocation_marker": {"type": "string", "minLength": 1, "not": {"pattern": "(?i)(password|secret|token|cookie|authorization|api[_-]?key)"}}
      }
    },
    "run_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "branch_id": {"type": "string", "minLength": 1},
    "risk_level": {"enum": ["r0-read-only", "r1-read-only-authenticated", "r2-ui-write-test", "r3-high-impact"]},
    "environment": {"enum": ["public", "test", "staging", "production"]},
    "approved": {"type": "boolean"},
    "approval_source": {"enum": ["explicit-cli", "pycharm-project-policy", "not-approved"]},
    "stable_runner_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "active_build_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "active_attachment_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "project_config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "attempt_ref": {"type": "string", "minLength": 1, "not": {"pattern": "^(?:[A-Za-z]:|/|\\\\)"}},
    "config_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract_version"],
      "properties": {
        "schema_version": {"const": "2.1"},
        "contract_version": {"const": 2},
        "origin_detection": {"const": "jetbrains-runner-path"},
        "entry_scope": {"const": "stable-active-runners"},
        "r2_authorization": {"const": "auto-test-only"},
        "run_scope": {"const": "per-node"},
        "r2_parallelism": {"const": "serial-project-environment"}
      }
    }
  }
}
