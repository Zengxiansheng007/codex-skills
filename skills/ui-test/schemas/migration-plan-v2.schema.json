{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/migration-plan.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_inventory_hash", "cases", "historical_policy", "formal_apply_authorized", "plan_hash"],
  "properties": {
    "schema_version": {"const": "ui-test.migration-plan.v2"},
    "source_inventory_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "historical_policy": {"const": "immutable-audit-only"},
    "formal_apply_authorized": {"const": false},
    "plan_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
