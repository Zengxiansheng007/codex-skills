{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/pre-submit-qualification-result.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "case_id", "branch_id", "build_fingerprint", "overall_status", "step_results", "screenshot_ref", "screenshot_sha256", "submit_count", "write_state", "sequence_allocated"],
  "properties": {
    "schema_version": {"const": "ui-test.pre-submit-qualification-result.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "branch_id": {"type": "string", "minLength": 1},
    "build_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "overall_status": {"enum": ["passed", "failed"]},
    "step_results": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "screenshot_ref": {"type": "string", "minLength": 1},
    "screenshot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "submit_count": {"const": 0},
    "write_state": {"const": "not_attempted"},
    "sequence_allocated": {"const": false}
  }
}
