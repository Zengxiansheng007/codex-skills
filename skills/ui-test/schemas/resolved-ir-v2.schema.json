{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/resolved-ir.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "branch_id", "source_hash", "test_data_hash", "parameter_manifest_hash", "dependency_digest", "resolved_steps"],
  "properties": {
    "schema_version": {"const": "ui-test.resolved-ir.v2"},
    "case_id": {"type": "string"},
    "branch_id": {"type": "string"},
    "source_hash": {"$ref": "#/$defs/hash"},
    "test_data_hash": {"$ref": "#/$defs/hash"},
    "parameter_manifest_hash": {"$ref": "#/$defs/hash"},
    "dependency_digest": {"$ref": "#/$defs/hash"},
    "resolved_steps": {"type": "array", "minItems": 1}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
