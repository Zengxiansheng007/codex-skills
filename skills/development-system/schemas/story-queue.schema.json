{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-queue.schema.json",
  "title": "CLW PH-2 Story Queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["anchorId", "phaseId", "stories"],
  "properties": {
    "anchorId": {"type": "string", "minLength": 1},
    "phaseId": {"const": "CLW-PH-2"},
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/story"}
    }
  },
  "$defs": {
    "story": {
      "type": "object",
      "additionalProperties": true,
      "required": ["storyId", "mappedRequirements", "acceptanceCriteria", "dependsOn", "priority", "status"],
      "properties": {
        "storyId": {"type": "string", "minLength": 1},
        "mappedRequirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "dependsOn": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "priority": {"type": "integer"},
        "status": {"enum": ["pending", "ready", "running", "review", "passed", "failed", "blocked"]}
      }
    }
  }
}
