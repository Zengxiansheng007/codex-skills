{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude-agent-registry.schema.json",
  "title": "Claude external Agent registry entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["agentId", "adapterId", "version", "capabilities", "availability", "feedbackSchemaRef", "completionAuthorityIsolated"],
  "properties": {
    "agentId": {"type": "string", "minLength": 1},
    "adapterId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "availability": {"enum": ["available", "unavailable", "degraded"]},
    "feedbackSchemaRef": {"type": "string", "minLength": 1},
    "completionAuthorityIsolated": {"const": true}
  }
}
