{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "merge-candidate.schema.json",
  "title": "CLW PH-3 Merge Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidateType", "candidateHash", "slotId", "storyId", "branch", "base", "head", "diffHash", "declaredWriteSet", "tests", "evidenceRefs", "mappedFrAc"],
  "properties": {
    "candidateType": {"const": "merge-candidate"},
    "candidateHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slotId": {"type": "string", "minLength": 1},
    "storyId": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "base": {"type": "string", "minLength": 1},
    "head": {"type": "string", "minLength": 1},
    "diffHash": {"type": "string", "minLength": 1},
    "declaredWriteSet": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tests": {"type": "array", "minItems": 1},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "mappedFrAc": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
