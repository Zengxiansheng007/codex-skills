{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent Skill Interface",
  "type": "object",
  "additionalProperties": false,
  "required": ["skillName", "version", "owner", "inputSchemaRef", "outputSchemaRef", "allowedActions", "forbiddenActions", "evidenceContract", "statusMapping"],
  "properties": {
    "skillName": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "inputSchemaRef": {"type": "string", "minLength": 1},
    "outputSchemaRef": {"type": "string", "minLength": 1},
    "allowedActions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "forbiddenActions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "evidenceContract": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "statusMapping": {"type": "object", "minProperties": 1},
    "changesCompletionAuthority": {"const": false},
    "implicitReplacement": {"const": false}
  }
}
