{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MetaGPT Module Admission Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["license", "version", "dependencies", "isolation", "exceptionPolicy", "testEvidence", "rollback", "codeRequested"],
  "properties": {
    "license": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "isolation": {"type": "string", "minLength": 1},
    "exceptionPolicy": {"type": "string", "minLength": 1},
    "testEvidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "rollback": {"type": "string", "minLength": 1},
    "codeRequested": {"type": "boolean"},
    "changesCompletionAuthority": {"const": false},
    "bypassesUnifiedContract": {"const": false}
  }
}
