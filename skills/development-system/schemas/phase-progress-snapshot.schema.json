{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase-progress-snapshot.schema.json",
  "title": "CLW PH-2 Aggregate Progress Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshotType", "anchorId", "anchorVersion", "phaseId", "workspaceFingerprint", "queueFingerprint", "stories", "currentRound", "counters", "evidenceRefs", "lastSequenceIndex", "lastEventHash"],
  "properties": {
    "snapshotType": {"const": "phase-progress"},
    "anchorId": {"type": "string", "minLength": 1},
    "anchorVersion": {"type": "string", "minLength": 1},
    "phaseId": {"type": "string", "minLength": 1},
    "workspaceFingerprint": {"type": "string", "minLength": 1},
    "queueFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stories": {"type": "array", "minItems": 1},
    "currentStoryId": {"type": ["string", "null"]},
    "currentRound": {"type": "integer", "minimum": 0},
    "counters": {"type": "object"},
    "evidenceRefs": {"type": "array", "items": {"type": "string"}},
    "blocker": {"type": ["string", "null"]},
    "nextAction": {"type": ["string", "null"]},
    "lastSequenceIndex": {"type": "integer", "minimum": 0},
    "lastEventHash": {"type": "string", "minLength": 7},
    "writtenAt": {"type": "string", "minLength": 1},
    "snapshotHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
