{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-profile.schema.json",
  "title": "CLW PH-4 Independent Agent Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileId", "agentId", "adapterId", "version", "capabilities", "inputSchemaRef", "outputSchemaRef", "allowedActions", "forbiddenActions", "statusMapping", "completionAuthorityIsolated"],
  "properties": {
    "profileId": {"type": "string", "minLength": 1},
    "agentId": {"type": "string", "minLength": 1},
    "adapterId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "inputSchemaRef": {"type": "string", "minLength": 1},
    "outputSchemaRef": {"type": "string", "minLength": 1},
    "allowedActions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "forbiddenActions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "statusMapping": {"type": "object", "minProperties": 1},
    "completionAuthorityIsolated": {"const": true}
  }
}
