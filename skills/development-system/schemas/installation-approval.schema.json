{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["approvalId", "status", "userApprovalRef", "validFrom", "expiresAt", "sourceHash", "targetPath", "targetBaselineHash", "coverage", "backupManifestRef", "rollbackPlanRef"],
  "properties": {
    "approvalId": {"type": "string", "minLength": 1},
    "status": {"const": "active"},
    "userApprovalRef": {"type": "string", "minLength": 1},
    "validFrom": {"type": "string", "minLength": 1},
    "expiresAt": {"type": "string", "minLength": 1},
    "sourceHash": {"type": "string", "minLength": 1},
    "targetPath": {"type": "string", "minLength": 1},
    "targetBaselineHash": {"type": "string", "minLength": 1},
    "coverage": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "backupManifestRef": {"type": "string", "minLength": 1},
    "rollbackPlanRef": {"type": "string", "minLength": 1}
  }
}

